# Offline mode needs nothing.
# DARKSPOT_SECRET: set a long random string on any public deployment. Without it, evidence is not signed.
DARKSPOT_SECRET=
# Live reader (optional): pip install anthropic, then set both:
ANTHROPIC_API_KEY=
DARKSPOT_MODEL=            # confirm the model string in the Anthropic console
# Search discovery (optional, untested here): Brave Search API key
BRAVE_API_KEY=
DARKSPOT_HOST=127.0.0.1
DARKSPOT_PORT=8000
DARKSPOT_RATE=60         # requests per minute per client (a run uses about 5)
